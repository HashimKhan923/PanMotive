{
  "expo": {
    "name": "Panmotive",
    "slug": "panmotive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "panmotive",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#15191E",
    "ios": {
      "bundleIdentifier": "com.panmotive.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:panmotive.com",
        "applinks:www.panmotive.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Panmotive uses the camera to scan your vehicle's VIN, so we can find parts that fit.",
        "NSPhotoLibraryUsageDescription": "Panmotive lets you attach photos when you message a seller or report a problem.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.panmotive.app",
      "adaptiveIcon": {
        "backgroundColor": "#E51B2B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "panmotive.com",
              "pathPrefix": "/products"
            },
            {
              "scheme": "https",
              "host": "panmotive.com",
              "pathPrefix": "/sellers"
            },
            {
              "scheme": "https",
              "host": "panmotive.com",
              "pathPrefix": "/shop"
            },
            {
              "scheme": "https",
              "host": "panmotive.com",
              "pathPrefix": "/deals"
            },
            {
              "scheme": "https",
              "host": "panmotive.com",
              "pathPrefix": "/orders"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15191E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Panmotive uses the camera to scan your vehicle's VIN, so we can find parts that fit.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E51B2B",
          "defaultChannel": "orders"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.panmotive.app",
          "enableGooglePay": true
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://panmotive.com/api/shop/v1",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bed30553-2e76-40e8-95c6-81238228dfb1"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "hashimkhan923s-organization",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
